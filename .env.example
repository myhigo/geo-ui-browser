# 复制一份为 .env 后按需填写。密码不要提交到仓库。
# 不带 GEO_ 前缀的 DB_* 是为了与常见部署习惯保持一致。

# —— 节点与存储 ——
# 多机部署时每台必须不同；单台保持 default
GEO_NODE_ID=default
# mysql（生产）| file（本机空跑测试）
GEO_STORAGE=mysql
# 宿主机持久化目录（compose 用它 bind mount 到容器内的 /data/geo）。必填，无默认值；
# 容器内路径恒为 /data/geo（固定不变），DB 存的是容器内路径 /data/geo/.profiles/<id>
GEO_DATA_DIR=

# —— 数据库（GEO_STORAGE=mysql 时必填）——
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# —— 业务 ——
# 对方服务地址（拉词 / 回推）
GEO_PULL_HOST=
# 单次采集超时（毫秒）
GEO_TIMEOUT_MS=180000

# —— 采集行为 ——
# none=不落盘（生产）| debug=落 diagnostics/ 供校准 selector
GEO_ARTIFACT_MODE=none
# 采集是否无头；登录窗口恒为有头（走 Xvfb + noVNC）
GEO_HEADLESS=true
# 同时打开浏览器上限
GEO_MAX_BROWSERS=4
# 同一出口 IP 同时跑的任务上限（1=最安全；确认无风控后再调大）
GEO_MAX_PER_EGRESS=1

# —— 登录窗口（/admin 内嵌）——
# 两种写法二选一（填错的表现就是登录窗口一片黑）：
# 1) 有 nginx 等反向代理：由它把 /novnc/ 转到容器 6080，这里填相对路径保持同源
#      GEO_NOVNC_URL=/novnc/vnc.html?autoconnect=1&resize=scale
# 2) 无反向代理（本机 / 直接部署）：必须填 6080 绝对地址，
#    否则 iframe 请求 8787/novnc/ 会 404 → 黑框
#      GEO_NOVNC_URL=http://127.0.0.1:6080/vnc.html?autoconnect=1&resize=scale
GEO_NOVNC_URL=http://127.0.0.1:6080/vnc.html?autoconnect=1&resize=scale

# —— 测试结果落盘（验证用，可选）——
# 每次采集把 截图 / 回答 / 信源 写到该目录，便于人工验证。
# 填容器内路径，建议放 /data/geo 下（会随 GEO_DATA_DIR 挂到宿主机，可直接打开看）。
# 留空 = 不落盘（生产默认）。
# GEO_TEST_OUT_DIR=/data/geo/test-results

# —— 截图压缩 ——
GEO_SHOT_FORMAT=webp
GEO_SHOT_QUALITY=80
GEO_SHOT_MAX_WIDTH=900
GEO_SHOT_MAX_BYTES=307200

# —— 可选 ——
# 探测不到 Chrome 版本时显式指定 UA
# GEO_FINGERPRINT_UA=
# 本机开发用系统 Chrome；容器里保持 false
# GEO_USE_SYSTEM_CHROME=false
